        "rrf",
        "marlin"
      ],
      "title": "Firmware",
      "type": "string"
    },
    "has_heated_bed": {
      "default": false,
      "title": "Has Heated Bed",
      "type": "boolean"
    },
    "kinematic_chain": {
      "$ref": "#/$defs/KinematicChain"
    },
    "max_e_feed_uL_per_min": {
      "default": 100.0,
      "exclusiveMinimum": 0.0,
      "title": "Max E Feed Ul Per Min",
      "type": "number"
    },
    "max_xy_feed_mm_per_min": {
      "default": 12000.0,
      "exclusiveMinimum": 0.0,
      "title": "Max Xy Feed Mm Per Min",
      "type": "number"
    },
    "max_z_feed_mm_per_min": {
      "default": 750.0,
      "exclusiveMinimum": 0.0,
      "title": "Max Z Feed Mm Per Min",
      "type": "number"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
