          "title": "X Mm",
          "type": "array"
        },
        "y_mm": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Y Mm",
          "type": "array"
        },
        "z_mm": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
