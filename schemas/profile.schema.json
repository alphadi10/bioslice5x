    "KinematicChain": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "three_axis",
            "tilt_swivel"
          ],
          "title": "Kind",
          "type": "string"
        },
        "swivel": {
          "anyOf": [
            {
              "$ref": "#/$defs/TiltSwivelAxis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tilt": {
          "anyOf": [
            {
              "$ref": "#/$defs/TiltSwivelAxis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "KinematicChain",
      "type": "object"
    },
    "TiltSwivelAxis": {
      "additionalProperties": false,
      "description": "Mapping from a canonical (tilt or swivel) joint to a G-code letter.",
      "properties": {
        "invert": {
          "default": false,
          "title": "Invert",
          "type": "boolean"
        },
        "letter": {
          "maxLength": 1,
          "minLength": 1,
          "title": "Letter",
          "type": "string"
        },
        "max_feed_deg_per_min": {
          "default": 5000.0,
          "exclusiveMinimum": 0.0,
          "title": "Max Feed Deg Per Min",
          "type": "number"
        },
        "range_deg": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Range Deg",
          "type": "array"
        },
        "rotates_about": {
          "enum": [
            "x",
            "y",
            "z"
          ],
          "title": "Rotates About",
          "type": "string"
        }
      },
      "required": [
        "rotates_about",
        "letter",
        "range_deg"
      ],
      "title": "TiltSwivelAxis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "build_volume": {
      "$ref": "#/$defs/BuildVolume"
    },
    "firmware": {
      "default": "rrf",
